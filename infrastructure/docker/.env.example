# Copie este arquivo para infrastructure/docker/.env (nunca commitado — ver .gitignore) antes
# de rodar `docker compose up`. Todos os valores abaixo são de DESENVOLVIMENTO apenas; nenhum
# deles deve ser reaproveitado em produção (produção usa AWS Secrets Manager — ver
# docs/infrastructure.md).

# Credenciais do PostgreSQL local (container). Qualquer valor serve em dev — só precisa ser
# consistente entre subidas para não invalidar o volume já criado.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-de-desenvolvimento
POSTGRES_DB=filesharing

# Chave de assinatura do JWT — só para desenvolvimento local. Gere uma própria, por exemplo:
#   openssl rand -base64 48
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-de-desenvolvimento-com-pelo-menos-32-bytes
