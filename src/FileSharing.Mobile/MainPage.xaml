<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FileSharing.Mobile.ViewModels"
             x:Class="FileSharing.Mobile.MainPage"
             x:DataType="viewmodels:UploadViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="FileSharing" Style="{StaticResource Headline}" />

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsNotAuthenticated}">
                <Entry Placeholder="E-mail" Text="{Binding Email}" Keyboard="Email" />
                <Entry Placeholder="Senha" Text="{Binding Password}" IsPassword="True" />
                <Button Text="Entrar" Command="{Binding LoginCommand}" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="LightGray" />

            <Button Text="Selecionar arquivo" Command="{Binding PickFileCommand}" IsEnabled="{Binding IsAuthenticated}" />
            <Button Text="Selecionar pasta" Command="{Binding PickFolderCommand}" IsEnabled="{Binding IsAuthenticated}" />

            <Label Text="{Binding StatusText}" />

            <ProgressBar Progress="{Binding UploadProgress}" IsVisible="{Binding IsUploading}" />

            <Button Text="Enviar" Command="{Binding UploadCommand}"
                    IsEnabled="{Binding IsAuthenticated}"
                    IsVisible="{Binding IsNotUploading}" />

            <Button Text="Cancelar" Command="{Binding CancelUploadCommand}" IsVisible="{Binding IsUploading}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
