<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        FileSharing brand palette (Fase 13 §7): blue as the single accent used for primary
        actions/progress/selection/active states — everything else stays neutral (white/gray)
        so the accent actually reads as meaningful rather than the whole screen being blue.
    -->

    <Color x:Key="Primary">#2563EB</Color>
    <Color x:Key="PrimaryDark">#1E40AF</Color>
    <Color x:Key="PrimaryLight">#93C5FD</Color>
    <Color x:Key="PrimaryTint">#EFF6FF</Color>

    <Color x:Key="Secondary">#0EA5E9</Color>
    <Color x:Key="Tertiary">#1E293B</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <!-- Neutral scale — the bulk of the UI (text, surfaces, dividers) so blue stays an accent. -->
    <Color x:Key="Gray50">#F8FAFC</Color>
    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray700">#334155</Color>
    <Color x:Key="Gray800">#1E293B</Color>
    <Color x:Key="Gray900">#0F172A</Color>

    <!-- Status — never conveyed by color alone in the UI itself (text/icon always present too),
         but still needed for the badge fills. -->
    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="SuccessTint">#DCFCE7</Color>
    <Color x:Key="Warning">#D97706</Color>
    <Color x:Key="WarningTint">#FEF3C7</Color>
    <Color x:Key="Danger">#DC2626</Color>
    <Color x:Key="DangerTint">#FEE2E2</Color>
    <Color x:Key="Neutral">#64748B</Color>
    <Color x:Key="NeutralTint">#F1F5F9</Color>

    <!-- "Glass" surfaces — a translucent fill + a slightly-more-opaque thin border is the
         performant approximation used everywhere instead of a real backdrop blur (Fase 13 §8). -->
    <Color x:Key="GlassSurface">#CCFFFFFF</Color>
    <Color x:Key="GlassSurfaceStrong">#F2FFFFFF</Color>
    <Color x:Key="GlassBorder">#33FFFFFF</Color>
    <Color x:Key="ScrimColor">#66000000</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
    <SolidColorBrush x:Key="PrimaryTintBrush" Color="{StaticResource PrimaryTint}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray50Brush" Color="{StaticResource Gray50}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray700Brush" Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="Gray800Brush" Color="{StaticResource Gray800}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>

    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="{StaticResource GlassSurface}"/>
    <SolidColorBrush x:Key="GlassSurfaceStrongBrush" Color="{StaticResource GlassSurfaceStrong}"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorder}"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}"/>

    <!-- Soft blue-tinted backdrop behind every page's glass cards — a gradient, never a flat
         "everything is blue" fill (Fase 13 §7's "não tornar toda a interface azul"). -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EFF6FF" Offset="0.0" />
        <GradientStop Color="#F8FAFC" Offset="0.45" />
        <GradientStop Color="#F1F5F9" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
