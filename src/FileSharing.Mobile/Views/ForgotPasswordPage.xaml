<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FileSharing.Mobile.Core.ViewModels;assembly=FileSharing.Mobile.Core"
             x:Class="FileSharing.Mobile.Views.ForgotPasswordPage"
             x:DataType="viewmodels:ForgotPasswordViewModel"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource AppBackgroundBrush}">

    <ScrollView>
        <Grid Padding="24" RowDefinitions="*,Auto,*" MinimumHeightRequest="600">

            <VerticalStackLayout Grid.Row="1" Spacing="28">

                <VerticalStackLayout Spacing="6">
                    <Label Text="Esqueci minha senha" Style="{StaticResource Headline}" TextColor="{StaticResource Primary}" />
                    <Label Text="Informe seu email e enviaremos um link para redefinir sua senha." Style="{StaticResource Caption}" />
                </VerticalStackLayout>

                <Border Style="{StaticResource GlassCardBorder}" IsVisible="{Binding RequestSent, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Email" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="voce@exemplo.com"
                                       SemanticProperties.Description="Email" />
                            </Border>
                        </VerticalStackLayout>

                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                        <Button Text="Enviar instruções" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />

                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource GlassCardBorder}" IsVisible="{Binding RequestSent}">
                    <VerticalStackLayout Spacing="12">
                        <Image Source="icon_circle_check.svg" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" />
                        <Label Text="Se a conta existir, enviaremos instruções para redefinir sua senha para o email informado."
                               Style="{StaticResource SuccessText}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Já tenho um token" Style="{StaticResource TextButton}" HorizontalOptions="Center" Command="{Binding GoToResetPasswordCommand}" />

                <Button Text="Voltar para o login" Style="{StaticResource TextButton}" HorizontalOptions="Center" Command="{Binding GoToLoginCommand}" />

            </VerticalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>
