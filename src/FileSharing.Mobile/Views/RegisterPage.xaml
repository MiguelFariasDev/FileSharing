<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FileSharing.Mobile.Core.ViewModels;assembly=FileSharing.Mobile.Core"
             xmlns:components="clr-namespace:FileSharing.Mobile.Components"
             x:Class="FileSharing.Mobile.Views.RegisterPage"
             x:DataType="viewmodels:RegisterViewModel"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource AppBackgroundBrush}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">

            <Button Text="&#8592; Voltar" Style="{StaticResource TextButton}" HorizontalOptions="Start"
                    Command="{Binding GoToLoginCommand}" />

            <VerticalStackLayout Spacing="6">
                <Label Text="Criar conta" Style="{StaticResource Headline}" TextColor="{StaticResource Primary}" />
                <Label Text="Leva menos de um minuto." Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <components:GlassCard>
                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="voce@exemplo.com" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Senha" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Mínimo de 8 caracteres" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Confirmar senha" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding ConfirmPassword}" IsPassword="True" Placeholder="Repita a senha" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
                    <Label Text="{Binding SuccessMessage}" Style="{StaticResource SuccessText}"
                           IsVisible="{Binding SuccessMessage, Converter={StaticResource StringToBoolConverter}}" />

                    <Button Text="Criar conta" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />

                </VerticalStackLayout>
            </components:GlassCard>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
