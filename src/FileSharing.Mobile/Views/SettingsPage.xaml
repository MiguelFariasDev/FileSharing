<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FileSharing.Mobile.Core.ViewModels;assembly=FileSharing.Mobile.Core"
             x:Class="FileSharing.Mobile.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource AppBackgroundBrush}">

    <VerticalStackLayout Padding="24" Spacing="16">

        <Grid ColumnDefinitions="Auto,*">
            <Button Grid.Column="0" ImageSource="icon_arrow_left.svg" Style="{StaticResource TextButton}" Clicked="OnBackClicked" />
            <Label Grid.Column="1" Text="Configurações" Style="{StaticResource SubHeadline}" VerticalOptions="Center" Margin="-40,0,0,0" HorizontalOptions="Center" />
        </Grid>

        <Border Style="{StaticResource GlassCardBorder}">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Tema" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Claro" Style="{StaticResource Caption}" VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource Gray200}" />
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Versão do aplicativo" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding AppVersion}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Button Text="Sair" ImageSource="icon_logout.svg" Style="{StaticResource DestructiveButton}" Command="{Binding LogoutCommand}" />

    </VerticalStackLayout>

</ContentPage>
