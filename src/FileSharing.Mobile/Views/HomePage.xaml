<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FileSharing.Mobile.Core.ViewModels;assembly=FileSharing.Mobile.Core"
             xmlns:components="clr-namespace:FileSharing.Mobile.Components"
             x:Class="FileSharing.Mobile.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header: greeting + avatar (Perfil lives behind the avatar, never a tab of its own —
             Fase de navegação §20). -->
        <Grid Grid.Row="0" Padding="24,20,24,8" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="Olá 👋" Style="{StaticResource Headline}" TextColor="{StaticResource Primary}" FontSize="24" />
                <Label Text="{Binding UserEmail}" Style="{StaticResource Caption}" />
            </VerticalStackLayout>
            <ImageButton Grid.Column="1" Source="icon_user_circle.svg" WidthRequest="36" HeightRequest="36"
                         BackgroundColor="Transparent" VerticalOptions="Start"
                         Command="{Binding GoToProfileCommand}"
                         SemanticProperties.Description="Perfil" />
        </Grid>

        <RefreshView Grid.Row="1" Command="{Binding LoadCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="24,0,24,24" Spacing="16">

                    <Button Text="Enviar arquivo" ImageSource="icon_upload.svg" Command="{Binding GoToUploadCommand}" />

                    <!-- Loading -->
                    <VerticalStackLayout IsVisible="{Binding IsLoading}" Spacing="12" Margin="0,24,0,0">
                        <ActivityIndicator IsRunning="{Binding IsLoading}" Color="{StaticResource Primary}" />
                        <Label Text="Carregando..." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Error -->
                    <VerticalStackLayout IsVisible="{Binding HasError}" Spacing="12" Margin="0,24,0,0">
                        <Image Source="icon_alert_triangle.svg" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" />
                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" HorizontalTextAlignment="Center" />
                        <Button Text="Tentar novamente" Style="{StaticResource SecondaryButton}" Command="{Binding LoadCommand}" />
                    </VerticalStackLayout>

                    <!-- Summary / recent files / empty state — shown once loading+error are past. -->
                    <VerticalStackLayout Spacing="16" IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" IsVisible="{Binding HasError, Converter={StaticResource InvertedBoolConverter}}">
                            <Border Grid.Column="0" Style="{StaticResource GlassCardBorder}" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding ActiveCount}" FontFamily="OpenSansSemibold" FontSize="22" TextColor="{StaticResource Success}" />
                                    <Label Text="Ativos" Style="{StaticResource Caption}" FontSize="11" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource GlassCardBorder}" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding ExpiringSoonCount}" FontFamily="OpenSansSemibold" FontSize="22" TextColor="{StaticResource Warning}" />
                                    <Label Text="Expirando" Style="{StaticResource Caption}" FontSize="11" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource GlassCardBorder}" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding RecentDownloadsCount}" FontFamily="OpenSansSemibold" FontSize="22" TextColor="{StaticResource Primary}" />
                                    <Label Text="Downloads" Style="{StaticResource Caption}" FontSize="11" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource GlassCardBorder}" IsVisible="{Binding LastActivityLabel, Converter={StaticResource StringToBoolConverter}}">
                            <HorizontalStackLayout Spacing="10">
                                <Image Source="icon_download.svg" WidthRequest="18" HeightRequest="18" />
                                <Label Text="{Binding LastActivityLabel}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Label Text="Arquivos recentes" Style="{StaticResource SubHeadline}" FontSize="16" IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}" />
                        <CollectionView ItemsSource="{Binding RecentFiles}" IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:FileItemViewModel">
                                    <components:FileCard File="{Binding .}"
                                                          MenuCommand="{Binding BindingContext.OpenFileDetailsCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button Text="Ver todos os arquivos" Style="{StaticResource TextButton}" Command="{Binding GoToFilesCommand}"
                                IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}" />

                        <VerticalStackLayout IsVisible="{Binding IsEmpty}" VerticalOptions="Center" Padding="0,32" Spacing="16">
                            <Image Source="icon_folder.svg" WidthRequest="48" HeightRequest="48" HorizontalOptions="Center" />
                            <Label Text="Você ainda não enviou nenhum arquivo." HorizontalTextAlignment="Center" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

    </Grid>

</ContentPage>
