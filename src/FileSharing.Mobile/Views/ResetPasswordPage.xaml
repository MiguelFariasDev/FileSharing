<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FileSharing.Mobile.Core.ViewModels;assembly=FileSharing.Mobile.Core"
             x:Class="FileSharing.Mobile.Views.ResetPasswordPage"
             x:DataType="viewmodels:ResetPasswordViewModel"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource AppBackgroundBrush}">

    <ScrollView>
        <Grid Padding="24" RowDefinitions="*,Auto,*" MinimumHeightRequest="600">

            <VerticalStackLayout Grid.Row="1" Spacing="28">

                <VerticalStackLayout Spacing="6">
                    <Label Text="Redefinir senha" Style="{StaticResource Headline}" TextColor="{StaticResource Primary}" />
                </VerticalStackLayout>

                <!-- 1) No token was supplied (opened from within the app, not from a link) — paste it by hand -->
                <Border Style="{StaticResource GlassCardBorder}" IsVisible="{Binding NeedsManualToken}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Cole abaixo o token recebido por email." Style="{StaticResource Caption}" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Token" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding TokenInput}" Placeholder="Token de recuperação"
                                       SemanticProperties.Description="Token de recuperação" />
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="Validar" Command="{Binding ValidateTokenCommand}" IsEnabled="{Binding IsValidatingToken, Converter={StaticResource InvertedBoolConverter}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 2) Validating the token -->
                <ActivityIndicator IsRunning="{Binding IsValidatingToken}" IsVisible="{Binding IsValidatingToken}" Color="{StaticResource Primary}" />

                <!-- 3) Token could not be redeemed -->
                <Border Style="{StaticResource GlassCardBorder}"
                        IsVisible="{Binding TokenErrorMessage, Converter={StaticResource StringToBoolConverter}}">
                    <VerticalStackLayout Spacing="12">
                        <Image Source="icon_alert_triangle.svg" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" />
                        <Label Text="{Binding TokenErrorMessage}" Style="{StaticResource ErrorText}" HorizontalTextAlignment="Center" />
                        <Button Text="Solicitar nova recuperação" Command="{Binding GoToForgotPasswordCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 4) New password form -->
                <Border Style="{StaticResource GlassCardBorder}" IsVisible="{Binding ShowForm}">
                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Nova senha" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding NewPassword}" IsPassword="True" Placeholder="Mínimo de 8 caracteres"
                                       SemanticProperties.Description="Nova senha" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Confirmar nova senha" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding ConfirmPassword}" IsPassword="True" Placeholder="Repita a senha"
                                       SemanticProperties.Description="Confirmar nova senha" />
                            </Border>
                        </VerticalStackLayout>

                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                        <Button Text="Redefinir senha" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />

                    </VerticalStackLayout>
                </Border>

                <!-- 5) Success -->
                <Border Style="{StaticResource GlassCardBorder}" IsVisible="{Binding ResetSucceeded}">
                    <VerticalStackLayout Spacing="12">
                        <Image Source="icon_circle_check.svg" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" />
                        <Label Text="Senha redefinida com sucesso." Style="{StaticResource SuccessText}" HorizontalTextAlignment="Center" />
                        <Button Text="Ir para o login" Command="{Binding GoToLoginCommand}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>
