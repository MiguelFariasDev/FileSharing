<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FileSharing.Mobile.Components.GlassCard"
             x:Name="Root">

    <!--
        The "glass" approximation used everywhere in this app (Fase 13 §8): a translucent white
        fill, a thin near-white border, and a soft dark drop shadow — cheap on every Android
        device, unlike a real backdrop blur, which .NET MAUI has no first-party cross-platform
        primitive for anyway. Card content goes through InnerContent so every screen can just
        write `<components:GlassCard>...</components:GlassCard>` like any normal container.
    -->
    <Border BackgroundColor="{StaticResource GlassSurface}"
            Stroke="{StaticResource GlassBorder}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 24"
            Padding="20"
            Shadow="{StaticResource GlassShadow}">
        <ContentPresenter Content="{Binding InnerContent, Source={x:Reference Root}}" />
    </Border>

</ContentView>
