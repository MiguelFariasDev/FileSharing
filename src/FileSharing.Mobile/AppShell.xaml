<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FileSharing.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FileSharing.Mobile.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Title="FileSharing">

    <!-- Login is the only top-level ShellContent outside the TabBar — the unauthenticated flow
         (Register/ForgotPassword/ResetPassword) is reached by pushing routes on top of it, never
         a tab. Once authenticated, the TabBar (Home/Arquivos/Enviar/Atividade) is the app's main
         navigation surface (Fase de navegação §20) — Profile/Settings/FileDetails/History are
         pushed on top of whichever tab is active, via Routing.RegisterRoute
         (AppShell.xaml.cs), not declared here, since they are relative/detail routes rather
         than top-level shell items. -->

    <ShellContent
        Route="login"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <TabBar>
        <ShellContent
            Route="home"
            Title="Home"
            Icon="icon_home.svg"
            ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent
            Route="files"
            Title="Arquivos"
            Icon="icon_files.svg"
            ContentTemplate="{DataTemplate views:FilesPage}" />
        <ShellContent
            Route="upload"
            Title="Enviar"
            Icon="icon_upload.svg"
            ContentTemplate="{DataTemplate views:UploadPage}" />
        <ShellContent
            Route="activity"
            Title="Atividade"
            Icon="icon_activity.svg"
            ContentTemplate="{DataTemplate views:ActivityPage}" />
    </TabBar>

</Shell>
