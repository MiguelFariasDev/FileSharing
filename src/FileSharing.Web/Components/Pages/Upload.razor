@page "/upload"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using FileSharing.Application.Common
@implements IAsyncDisposable
@inject FileSharingApiClient ApiClient
@inject IJSRuntime JsRuntime

<PageTitle>Enviar arquivo — FileSharing</PageTitle>

<h1 class="h3 mb-3">Enviar arquivo</h1>

@if (_stage == Stage.Idle)
{
    <p class="text-muted">Envie um arquivo ou uma pasta inteira. Uma pasta é compactada em ZIP no seu próprio navegador antes do envio — o conteúdo vai direto para o armazenamento, sem passar pelo servidor da aplicação.</p>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    <div class="d-flex flex-wrap gap-2 mb-2">
        <button type="button" class="btn btn-primary" @onclick="TriggerFilePickerAsync">
            <Icon Name="upload" Size="1rem" /> Selecionar arquivo
        </button>
        <button type="button" class="btn btn-outline-secondary" @onclick="TriggerFolderPickerAsync">
            <Icon Name="folder" Size="1rem" /> Selecionar pasta
        </button>
    </div>

    <input type="file" @ref="_fileInputRef" id="upload-file-input" class="visually-hidden" @onchange="OnFilePickedAsync" />
    <input type="file" @ref="_folderInputRef" id="upload-folder-input" class="visually-hidden" webkitdirectory multiple @onchange="OnFolderPickedAsync" />

    <p class="text-muted small mt-2">Tamanho máximo: @FileDisplayFormatting.FormatSize(MaxUploadSizeBytes).</p>
}
else if (_stage == Stage.Failed)
{
    <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="Reset">Tentar novamente</button>
}
else if (_stage == Stage.Completed)
{
    <div class="alert alert-success py-2" role="status">Upload concluído com sucesso.</div>

    @if (_generatedLink is not null)
    {
        <div class="d-flex flex-column gap-1 mb-3">
            <code class="small text-truncate d-inline-block" style="max-width: 420px;">@_generatedLink</code>
            <button type="button" class="btn btn-sm btn-outline-primary" style="width: fit-content;" @onclick="CopyLinkAsync">
                <Icon Name="copy" Size="1rem" /> Copiar link
            </button>
        </div>
    }

    <div class="d-flex gap-2">
        <a href="@($"/files/{_completedFileId}")" class="btn btn-primary btn-sm">Ver detalhes</a>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Reset">Enviar outro arquivo</button>
    </div>
}
else
{
    <p class="mb-1">@_selectedName</p>
    <div class="progress" role="progressbar" aria-valuenow="@_progressPercent" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar" style="width:@(_progressPercent)%">@(_progressPercent)%</div>
    </div>
    <p class="small text-muted mt-1">@StageLabel</p>

    <button type="button" class="btn btn-outline-secondary btn-sm mt-2" @onclick="CancelUpload" disabled="@(_stage != Stage.Uploading)">
        Cancelar
    </button>
}

<p class="mt-3 mb-0"><a href="/dashboard">Voltar para meus arquivos</a></p>

@code {
    private enum Stage { Idle, Zipping, Preparing, Uploading, Completing, Completed, Failed }

    // Direct browser -> S3 (see wwwroot/js/upload.js) — no Blazor Server circuit limit applies
    // to file bytes anymore, so this mirrors the Api's own FileStorageOptions.MaxFileSizeBytes
    // default (5 GiB) instead of the old, circuit-imposed 200 MB cap.
    private const long MaxUploadSizeBytes = 5L * 1024 * 1024 * 1024;

    private ElementReference _fileInputRef;
    private ElementReference _folderInputRef;
    private DotNetObjectReference<Upload>? _dotNetRef;

    private Stage _stage = Stage.Idle;
    private string? _jsHandleId;
    private string? _selectedName;
    private double _progressFraction;
    private string? _errorMessage;
    private string? _generatedLink;
    private Guid _completedFileId;
    private bool _cancelRequested;

    private int _progressPercent => (int)(_progressFraction * 100);

    private string StageLabel => _stage switch
    {
        Stage.Zipping => "Compactando pasta...",
        Stage.Preparing => "Preparando...",
        Stage.Uploading => "Enviando com segurança...",
        Stage.Completing => "Finalizando...",
        _ => string.Empty
    };

    protected override void OnInitialized() => _dotNetRef = DotNetObjectReference.Create(this);

    // Public (not private) purely so bUnit tests can Setup<Upload.SelectionMeta>/<Upload.UploadJsResult>
    // for these exact JS interop return types — bUnit matches a setup by identifier AND TResult.
    public record SelectionMeta(string Id, string Name, long Size, string ContentType);

    public record UploadJsResult(bool Ok, int Status);

    private Task TriggerFilePickerAsync() => JsRuntime.InvokeVoidAsync("fileSharingUpload.triggerClick", _fileInputRef).AsTask();

    private Task TriggerFolderPickerAsync() => JsRuntime.InvokeVoidAsync("fileSharingUpload.triggerClick", _folderInputRef).AsTask();

    private async Task OnFilePickedAsync(ChangeEventArgs _)
    {
        var meta = await JsRuntime.InvokeAsync<SelectionMeta?>("fileSharingUpload.prepareFile", _fileInputRef);
        if (meta is null)
            return;

        await ValidateAndUploadAsync(meta, isFolder: false);
    }

    private async Task OnFolderPickedAsync(ChangeEventArgs _)
    {
        _errorMessage = null;
        _stage = Stage.Zipping;
        _selectedName = "pasta selecionada";
        _progressFraction = 0;
        StateHasChanged();

        var folderZipName = $"pasta-{DateTimeOffset.UtcNow:yyyyMMdd-HHmmss}.zip";
        var meta = await JsRuntime.InvokeAsync<SelectionMeta?>("fileSharingUpload.prepareFolderZip", _folderInputRef, _dotNetRef, folderZipName);

        if (meta is null)
        {
            _stage = Stage.Idle;
            return;
        }

        await ValidateAndUploadAsync(meta, isFolder: true);
    }

    private async Task ValidateAndUploadAsync(SelectionMeta meta, bool isFolder)
    {
        _errorMessage = null;

        if (!FileTypePolicy.IsContentTypeAllowed(meta.ContentType))
        {
            _errorMessage = "Tipo de arquivo não permitido.";
            _stage = Stage.Idle;
            await JsRuntime.InvokeVoidAsync("fileSharingUpload.cleanup", meta.Id);
            return;
        }

        if (meta.Size <= 0 || meta.Size > MaxUploadSizeBytes)
        {
            _errorMessage = $"O arquivo excede o limite de {FileDisplayFormatting.FormatSize(MaxUploadSizeBytes)}.";
            _stage = Stage.Idle;
            await JsRuntime.InvokeVoidAsync("fileSharingUpload.cleanup", meta.Id);
            return;
        }

        await UploadAsync(meta, isFolder);
    }

    private async Task UploadAsync(SelectionMeta meta, bool isFolder)
    {
        _jsHandleId = meta.Id;
        _selectedName = meta.Name;
        _cancelRequested = false;
        _stage = Stage.Preparing;
        _progressFraction = 0;
        StateHasChanged();

        var initiateResult = await ApiClient.InitiateUploadAsync(
            new InitiateUploadRequest(meta.Name, meta.ContentType, meta.Size, isFolder));

        if (!initiateResult.IsSuccess)
        {
            await FailAsync(initiateResult.Message);
            return;
        }

        if (_cancelRequested)
        {
            await FailAsync("Envio cancelado.");
            return;
        }

        var initiated = initiateResult.Value!;

        _stage = Stage.Uploading;
        StateHasChanged();

        var uploadResult = await JsRuntime.InvokeAsync<UploadJsResult>(
            "fileSharingUpload.uploadToPresignedUrl", meta.Id, initiated.UploadUrl, meta.ContentType, _dotNetRef);

        if (!uploadResult.Ok)
        {
            await FailAsync(_cancelRequested
                ? "Envio cancelado."
                : "Não foi possível concluir o envio. Verifique sua conexão e tente novamente.");
            return;
        }

        _stage = Stage.Completing;
        StateHasChanged();

        var completeResult = await ApiClient.CompleteUploadAsync(initiated.FileId);
        if (!completeResult.IsSuccess)
        {
            await FailAsync(completeResult.Message);
            return;
        }

        await JsRuntime.InvokeVoidAsync("fileSharingUpload.cleanup", meta.Id);
        _completedFileId = completeResult.Value!.FileId;

        // Best effort — a failure to generate one right after upload is not itself an upload
        // failure, the user can still generate it later from File Details.
        var linkResult = await ApiClient.GenerateLinkAsync(_completedFileId);
        _generatedLink = linkResult.IsSuccess ? linkResult.Value!.PublicUrl : null;

        _stage = Stage.Completed;
        _jsHandleId = null;
    }

    private async Task FailAsync(string? message)
    {
        if (_jsHandleId is not null)
            await JsRuntime.InvokeVoidAsync("fileSharingUpload.cleanup", _jsHandleId);

        _jsHandleId = null;
        _stage = Stage.Failed;
        _errorMessage = message;
    }

    [JSInvokable]
    public void OnZipProgress(double fraction)
    {
        _progressFraction = fraction;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnUploadProgress(double fraction)
    {
        _progressFraction = fraction;
        InvokeAsync(StateHasChanged);
    }

    private void CancelUpload()
    {
        _cancelRequested = true;
        if (_jsHandleId is not null)
            _ = JsRuntime.InvokeVoidAsync("fileSharingUpload.cancel", _jsHandleId);
    }

    private async Task CopyLinkAsync()
    {
        if (_generatedLink is null)
            return;

        try
        {
            await JsRuntime.InvokeVoidAsync("fileSharingInterop.copyToClipboard", _generatedLink);
        }
        catch (JSException)
        {
            // Best-effort — the link is still visible/selectable on screen even if the
            // clipboard API is unavailable.
        }
    }

    private void Reset()
    {
        _stage = Stage.Idle;
        _jsHandleId = null;
        _selectedName = null;
        _progressFraction = 0;
        _errorMessage = null;
        _generatedLink = null;
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsHandleId is not null)
        {
            try
            {
                await JsRuntime.InvokeVoidAsync("fileSharingUpload.cleanup", _jsHandleId);
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone (e.g. browser tab closed mid-upload) — nothing to clean up on the client anymore either.
            }
        }

        _dotNetRef?.Dispose();
    }
}
