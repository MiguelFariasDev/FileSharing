@page "/forgot-password"
@layout FileSharing.Web.Components.Layout.AuthLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject FileSharingApiClient ApiClient

<PageTitle>Recuperar senha — FileSharing</PageTitle>

<h1 class="h3 mb-3">Esqueci minha senha</h1>

@if (_requestSent)
{
    <div class="alert alert-success py-2" role="status">
        Se a conta existir, enviaremos instruções para redefinir sua senha para o email informado.
    </div>
}
else
{
    <p class="text-muted">Informe seu email e enviaremos um link para redefinir sua senha.</p>

    <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="forgot-password-email" class="form-label">Email</label>
            <InputText id="forgot-password-email" class="form-control" @bind-Value="_model.Email" autocomplete="username" aria-describedby="forgot-password-email-error" />
            <ValidationMessage For="() => _model.Email" id="forgot-password-email-error" class="text-danger small" />
        </div>

        @if (_errorMessage is not null)
        {
            <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
        }

        <button type="submit" class="btn btn-primary w-100" disabled="@_isBusy">
            @if (_isBusy)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
            }
            Enviar instruções
        </button>
    </EditForm>
}

<p class="mt-3 text-center mb-0">
    <a href="/login">Voltar para o login.</a>
</p>

@code {
    private readonly ForgotPasswordModel _model = new();
    private string? _errorMessage;
    private bool _isBusy;
    private bool _requestSent;

    private async Task HandleSubmitAsync()
    {
        _errorMessage = null;
        _isBusy = true;

        try
        {
            var result = await ApiClient.ForgotPasswordAsync(_model.Email);

            // The Api itself never distinguishes "email exists" from "email doesn't" (see
            // AuthController.ForgotPassword) — this page shows the same success state
            // regardless, and only a genuine transport/validation failure reaches _errorMessage.
            if (!result.IsSuccess)
            {
                _errorMessage = result.Message;
                return;
            }

            _requestSent = true;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Informe seu email.")]
        [EmailAddress(ErrorMessage = "Informe um email válido.")]
        public string Email { get; set; } = string.Empty;
    }
}
