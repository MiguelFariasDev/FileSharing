@page "/dashboard"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@inject FileSharingApiClient ApiClient
@inject FileSharing.Web.Services.Notifications.NotificationInboxService Inbox

<PageTitle>Dashboard — FileSharing</PageTitle>

<h1 class="h3 mb-3">Dashboard</h1>

@if (_loading)
{
    <p role="status">Carregando...</p>
}
else if (_loadError is not null)
{
    <div class="alert alert-danger" role="alert">
        @_loadError
        <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="LoadAsync">Tentar novamente</button>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="border rounded-4 p-3 h-100">
                <div class="text-muted small">Arquivos ativos</div>
                <div class="fs-3 fw-bold text-success">@_activeCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="border rounded-4 p-3 h-100">
                <div class="text-muted small">Expirando em breve</div>
                <div class="fs-3 fw-bold text-warning">@_expiringSoonCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="border rounded-4 p-3 h-100">
                <div class="text-muted small">Arquivos expirados</div>
                <div class="fs-3 fw-bold text-danger">@_expiredCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="border rounded-4 p-3 h-100">
                <div class="text-muted small">Downloads recentes</div>
                <div class="fs-3 fw-bold text-primary">@Inbox.Entries.Count</div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a href="/upload" class="btn btn-primary"><Icon Name="upload" Size="1rem" /> Enviar arquivo</a>
        <a href="/files" class="btn btn-outline-secondary"><Icon Name="files" Size="1rem" /> Meus arquivos</a>
        <a href="/notifications" class="btn btn-outline-secondary"><Icon Name="bell" Size="1rem" /> Notificações</a>
    </div>

    <h2 class="h5 mb-3">Arquivos recentes</h2>

    @if (_recentFiles.Count == 0)
    {
        <p class="text-muted">Você ainda não possui arquivos. <a href="/upload">Envie o primeiro</a>.</p>
    }
    else
    {
        <div class="list-group">
            @foreach (var file in _recentFiles)
            {
                <a href="@($"/files/{file.FileId}")" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <span class="text-truncate">@file.OriginalFileName</span>
                    <span class="badge @FileDisplayFormatting.StatusBadgeClass(file)">@FileDisplayFormatting.StatusLabel(file)</span>
                </a>
            }
        </div>
    }
}

@code {
    private bool _loading = true;
    private string? _loadError;
    private int _activeCount;
    private int _expiringSoonCount;
    private int _expiredCount;
    private List<FileSummaryResponse> _recentFiles = [];

    protected override async Task OnInitializedAsync()
    {
        Inbox.Changed += OnInboxChanged;
        await LoadAsync();
    }

    private void OnInboxChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        StateHasChanged();

        var result = await ApiClient.GetMyFilesAsync();

        if (!result.IsSuccess)
        {
            _loadError = result.Message;
            _loading = false;
            return;
        }

        var files = result.Value!;
        var now = DateTimeOffset.UtcNow;

        _activeCount = files.Count(f => f.Status == "Active" && !IsEffectivelyExpired(f, now));
        _expiredCount = files.Count(f => f.Status == "Expired" || IsEffectivelyExpired(f, now));
        _expiringSoonCount = files.Count(f =>
            f.Status == "Active" && f.ExpiresAt is { } expiresAt &&
            expiresAt > now && expiresAt <= now.AddHours(2));

        _recentFiles = files.OrderByDescending(f => f.CreatedAt).Take(5).ToList();
        _loading = false;
    }

    private static bool IsEffectivelyExpired(FileSummaryResponse file, DateTimeOffset now) =>
        file.Status == "Active" && file.ExpiresAt is { } expiresAt && expiresAt <= now;

    public void Dispose()
    {
        Inbox.Changed -= OnInboxChanged;
    }
}
