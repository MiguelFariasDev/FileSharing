@page "/reset-password"
@layout FileSharing.Web.Components.Layout.AuthLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject FileSharingApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Redefinir senha — FileSharing</PageTitle>

<h1 class="h3 mb-3">Redefinir senha</h1>

@if (_isValidatingToken)
{
    <div class="d-flex justify-content-center py-3">
        <span class="spinner-border" aria-hidden="true"></span>
    </div>
}
else if (_tokenErrorMessage is not null)
{
    <div class="alert alert-danger py-2" role="alert">@_tokenErrorMessage</div>
    <p class="mt-3 text-center mb-0">
        <a href="/forgot-password">Solicitar uma nova recuperação de senha.</a>
    </p>
}
else if (_resetSucceeded)
{
    <div class="alert alert-success py-2" role="status">Senha redefinida com sucesso.</div>
    <p class="mt-3 text-center mb-0">
        <a href="/login">Ir para o login.</a>
    </p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="reset-password-new" class="form-label">Nova senha</label>
            <InputText id="reset-password-new" type="password" class="form-control" @bind-Value="_model.NewPassword" autocomplete="new-password" aria-describedby="reset-password-new-error reset-password-new-hint" />
            <div id="reset-password-new-hint" class="form-text">Mínimo de 8 caracteres.</div>
            <ValidationMessage For="() => _model.NewPassword" id="reset-password-new-error" class="text-danger small" />
        </div>

        <div class="mb-3">
            <label for="reset-password-confirm" class="form-label">Confirmar nova senha</label>
            <InputText id="reset-password-confirm" type="password" class="form-control" @bind-Value="_model.ConfirmPassword" autocomplete="new-password" aria-describedby="reset-password-confirm-error" />
            <ValidationMessage For="() => _model.ConfirmPassword" id="reset-password-confirm-error" class="text-danger small" />
        </div>

        @if (_errorMessage is not null)
        {
            <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
        }

        <button type="submit" class="btn btn-primary w-100" disabled="@_isBusy">
            @if (_isBusy)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
            }
            Redefinir senha
        </button>
    </EditForm>
}

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private readonly ResetPasswordModel _model = new();
    private string? _errorMessage;
    private string? _tokenErrorMessage;
    private bool _isBusy;
    private bool _isValidatingToken = true;
    private bool _resetSucceeded;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            _tokenErrorMessage = "Este link de recuperação é inválido.";
            _isValidatingToken = false;
            return;
        }

        var result = await ApiClient.ValidateResetTokenAsync(Token);
        if (!result.IsSuccess)
            _tokenErrorMessage = MessageForCode(result.Code, result.Message!);

        _isValidatingToken = false;
    }

    private async Task HandleSubmitAsync()
    {
        _errorMessage = null;
        _isBusy = true;

        try
        {
            var result = await ApiClient.ResetPasswordAsync(Token!, _model.NewPassword);
            if (!result.IsSuccess)
            {
                // A token can expire/be used by another tab between page load and submit — that
                // case is shown the same way the initial validation failure is, not as a generic
                // form error.
                if (result.Code is "AUTH_PASSWORD_RESET_EXPIRED" or "AUTH_PASSWORD_RESET_USED" or "AUTH_PASSWORD_RESET_INVALID")
                    _tokenErrorMessage = MessageForCode(result.Code, result.Message!);
                else
                    _errorMessage = result.Message;

                return;
            }

            _resetSucceeded = true;
        }
        finally
        {
            _isBusy = false;
        }
    }

    // Client-owned copy, never the raw server message — see docs/api-errors.md: the Mobile/Web
    // contract is the "code", not whatever Portuguese sentence the Api happens to send today.
    private static string MessageForCode(string? code, string fallback) => code switch
    {
        "AUTH_PASSWORD_RESET_EXPIRED" => "Este link de recuperação expirou. Solicite uma nova recuperação de senha.",
        "AUTH_PASSWORD_RESET_USED" => "Este link de recuperação já foi utilizado. Solicite uma nova recuperação de senha, se necessário.",
        "AUTH_PASSWORD_RESET_INVALID" => "Este link de recuperação é inválido.",
        _ => fallback
    };

    private class ResetPasswordModel
    {
        [Required(ErrorMessage = "Informe a nova senha.")]
        [MinLength(8, ErrorMessage = "A senha deve ter pelo menos 8 caracteres.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirme a nova senha.")]
        [Compare(nameof(NewPassword), ErrorMessage = "As senhas não coincidem.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
