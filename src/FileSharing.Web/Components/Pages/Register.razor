@page "/register"
@layout FileSharing.Web.Components.Layout.AuthLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject FileSharingApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Cadastro — FileSharing</PageTitle>

<h1 class="h3 mb-3">Criar conta</h1>

<EditForm Model="_model" OnValidSubmit="HandleRegisterAsync">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label for="register-email" class="form-label">Email</label>
        <InputText id="register-email" class="form-control" @bind-Value="_model.Email" autocomplete="username" aria-describedby="register-email-error" />
        <ValidationMessage For="() => _model.Email" id="register-email-error" class="text-danger small" />
    </div>

    <div class="mb-3">
        <label for="register-password" class="form-label">Senha</label>
        <InputText id="register-password" type="password" class="form-control" @bind-Value="_model.Password" autocomplete="new-password" aria-describedby="register-password-error register-password-hint" />
        <div id="register-password-hint" class="form-text">Mínimo de 8 caracteres.</div>
        <ValidationMessage For="() => _model.Password" id="register-password-error" class="text-danger small" />
    </div>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
    }

    @if (_successMessage is not null)
    {
        <div class="alert alert-success py-2" role="status">@_successMessage</div>
    }

    <button type="submit" class="btn btn-primary w-100" disabled="@_isBusy">
        @if (_isBusy)
        {
            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
        }
        Cadastrar
    </button>
</EditForm>

<p class="mt-3 text-center mb-0">
    Já possui conta? <a href="/login">Entrar.</a>
</p>

@code {
    private readonly RegisterModel _model = new();
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isBusy;

    private async Task HandleRegisterAsync()
    {
        _errorMessage = null;
        _successMessage = null;
        _isBusy = true;

        try
        {
            var result = await ApiClient.RegisterAsync(_model.Email, _model.Password);
            if (!result.IsSuccess)
            {
                _errorMessage = result.Message;
                return;
            }

            // Registering does not authenticate the caller (POST /api/auth/register returns a
            // UserResponse, never a token) — send the user to /login rather than assuming
            // they're signed in.
            _successMessage = "Cadastro concluído. Redirecionando para o login...";
            await Task.Delay(TimeSpan.FromSeconds(1.5));
            Navigation.NavigateTo("/login");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private class RegisterModel
    {
        [Required(ErrorMessage = "Informe seu email.")]
        [EmailAddress(ErrorMessage = "Informe um email válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe sua senha.")]
        [MinLength(8, ErrorMessage = "A senha deve ter pelo menos 8 caracteres.")]
        public string Password { get; set; } = string.Empty;
    }
}
